auto.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile auto.pro

qmake_all: sub-tst_myclass-qmake_all FORCE

make_first: sub-tst_myclass-make_first  FORCE
all: sub-tst_myclass-all  FORCE
clean: sub-tst_myclass-clean  FORCE
distclean: sub-tst_myclass-distclean  FORCE
	-$(DEL_FILE) Makefile
install_subtargets: sub-tst_myclass-install_subtargets FORCE
uninstall_subtargets: sub-tst_myclass-uninstall_subtargets FORCE

sub-tst_myclass-check:
	@test -d tst_myclass/ || mkdir -p tst_myclass/
	cd tst_myclass/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/developer/src/qt5_qml/floodit/tests/auto/tst_myclass/tst_myclass.pro ) && $(MAKE) -f Makefile check
check: sub-tst_myclass-check

sub-tst_myclass-benchmark:
	@test -d tst_myclass/ || mkdir -p tst_myclass/
	cd tst_myclass/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/developer/src/qt5_qml/floodit/tests/auto/tst_myclass/tst_myclass.pro ) && $(MAKE) -f Makefile benchmark
benchmark: sub-tst_myclass-benchmark
install:install_subtargets  FORCE

uninstall: uninstall_subtargets FORCE

FORCE:

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

